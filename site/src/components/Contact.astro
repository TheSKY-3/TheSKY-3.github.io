---
import { profile } from '../data/profile';
---
<section class="section" id="contact">
  <div class="container contact-inner">
    <span class="eyebrow">联系 / CONTACT</span>
    <h2>两份简历可直接下载，项目细节欢迎邮件交流</h2>
    <p>
      <a href={profile.resumes[0].href} download>{profile.resumes[0].label} ↓</a>
      &nbsp;·&nbsp;
      <a href={profile.resumes[1].href} download>{profile.resumes[1].label} ↓</a>
    </p>
    <p>{profile.location} · {profile.availability}</p>
    <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
    <p class="gh">
      项目代码与复现细节：<a href={profile.github} target="_blank" rel="noopener noreferrer">github.com/TheSKY-3 ↗</a>
    </p>
  </div>
</section>
<style>
  .contact-inner { text-align: left; }
  .mail { font-family: var(--font-mono); font-size: clamp(18px, 3vw, 24px); color: var(--c-amber); }
  .gh { margin-top: var(--space-2); font-size: 14px; color: var(--c-mist); }
  .gh a { color: var(--c-ice); font-family: var(--font-mono); }
  .gh a:hover { color: var(--c-amber); }
</style>
