---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
const agentProjects = projects.filter((p) => p.track === 'agent');
const dataProjects = projects.filter((p) => p.track !== 'agent');
---
<section class="section" id="projects">
  <div class="container">
    <span class="eyebrow">项目作品集 / PROJECTS</span>
    <h2>六个可验证的项目</h2>
    <p class="lead">代码公开、评测集冻结、证据边界写明——每个结论都能回查，每个数字都能复算。</p>
    <h3 class="group-label">Agent / LLM 应用</h3>
    <div class="proj-grid">
      {agentProjects.map((p) => <ProjectCard p={p} wide={p.slug === 'maotai-rag'} />)}
    </div>
    <h3 class="group-label">数据分析 / 经营分析</h3>
    <div class="proj-grid">
      {dataProjects.map((p) => <ProjectCard p={p} />)}
    </div>
  </div>
</section>
<style>
  .lead { max-width: 78ch; margin: 0; font-size: 15px; color: var(--c-ice); }
  .group-label { margin: var(--space-4) 0 0; font-size: 15px; color: var(--c-ice); font-weight: 600; letter-spacing: 0.04em; }
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); margin-top: var(--space-2); }
  @media (max-width: 900px) { .proj-grid { grid-template-columns: 1fr; } }
</style>
